---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import FloatingActions from '../components/FloatingActions.astro';
import PrintFrame from '../components/PrintFrame.astro';
import Footer from '../components/Footer.astro';
import { AFFILIATION_LINE, ANALYTICS_TOKEN, SITE } from '../lib/site';

interface Props { title?: string; description?: string; noindex?: boolean; path?: string }
const DEFAULT_DESC =
  'Clarity before commitment. UAE property analysis for investors: price, yield, costs and exit, before anyone asks you to sign.';
const { title, description = DEFAULT_DESC, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.title}`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = SITE.origin + (pathname === '/' ? '' : pathname);
// Only a production-indexable build (which requires a BRN) may be indexed, and only for pages with real content.
const robots = SITE.indexable && !noindex ? 'index,follow,max-image-preview:large' : 'noindex,nofollow';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: SITE.name,
  jobTitle: SITE.title,
  url: SITE.origin,
  telephone: `+${SITE.phoneE164}`,
  email: SITE.email,
  areaServed: SITE.areasServed,
  knowsLanguage: SITE.languages,
  sameAs: [SITE.instagram, SITE.linkedin],
  // Like the visible line: the BRN is published only once the agency is confirmed too (owner decision 2026-10-10).
  ...(AFFILIATION_LINE ? { identifier: { '@type': 'PropertyValue', name: 'BRN', value: SITE.brn } } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#14252F" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE.origin}/og.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      // First-touch attribution for the lead form. Wrapped: storage can be unavailable.
      try {
        if (!sessionStorage.getItem('ck_attr')) {
          var p = new URLSearchParams(location.search), a = { landing_page: location.pathname };
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) { if (p.get(k)) a[k] = p.get(k); });
          if (document.referrer && new URL(document.referrer).hostname.replace(/^www\./, '') !== location.hostname.replace(/^www\./, '')) a.referrer = document.referrer;
          sessionStorage.setItem('ck_attr', JSON.stringify(a));
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <PrintFrame position="head" />
    <main id="main"><slot /></main>
    <PrintFrame position="foot" />
    <FloatingActions />
    <Footer />
    {ANALYTICS_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>
    )}
  </body>
</html>
