---
import '../styles/global.css';
import serifNormal from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';
import Nav from '../components/Nav.astro';
import FloatingActions from '../components/FloatingActions.astro';
import PrintFrame from '../components/PrintFrame.astro';
import Footer from '../components/Footer.astro';
import { AFFILIATION_LINE, ANALYTICS_TOKEN, SITE } from '../lib/site';
import { GOLIVE } from '../lib/golive';
import { canonicalUrl, pageTitle } from '../lib/seo.mjs';
import { jsonLd } from '../lib/jsonld.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // Insight articles (audit item 21): og:type article and an Article node in the JSON-LD.
  article?: { headline: string; datePublished: string; dateModified: string };
}
const DEFAULT_DESC =
  'Clarity before commitment. UAE property analysis for investors: price, yield, costs and exit, before anyone asks you to sign.';
const { title, description = DEFAULT_DESC, noindex = false, article } = Astro.props;
// At most 60 characters (lib/seo.mjs): "<title> · Sharjeel Hashmat", or the title alone when that would be longer.
const fullTitle = pageTitle(title, SITE.name, SITE.title);
// Only a production-indexable build (which requires the ORN and BRN) may be indexed, and only for pages with real content.
const indexed = SITE.indexable && !noindex;
const robots = indexed ? 'index,follow,max-image-preview:large' : 'noindex,nofollow';
// Canonical and og:url only on indexed pages (never with noindex, never on the 404), in the sitemap's form: no ".html",
// no "/index", home is origin + "/" (lib/seo.mjs).
const canonical = indexed ? canonicalUrl(SITE.origin, Astro.url.pathname) : null;
// Person always (with the broker's BRN once the agency line shows); the RealEstateAgent (agency, ORN, address) only once
// golive.ts has them (audit item 16, lib/jsonld.mjs).
const ld = jsonLd({
  site: SITE,
  agency: AFFILIATION_LINE && GOLIVE.agencyAddress ? { name: SITE.brokerage, orn: SITE.orn, address: GOLIVE.agencyAddress } : null,
  brn: AFFILIATION_LINE ? SITE.brn : '',
  permitNo: GOLIVE.advertiserPermitNo,
  article: article ? { ...article, url: canonicalUrl(SITE.origin, Astro.url.pathname) } : null,
});
const OG_IMAGE_ALT = `${SITE.name}, ${SITE.title} · UAE`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#14252F" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={serifNormal} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${SITE.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE.origin}/og.png`} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      // First-touch attribution for the lead form. Wrapped: storage can be unavailable.
      try {
        if (!sessionStorage.getItem('ck_attr')) {
          var p = new URLSearchParams(location.search), a = { landing_page: location.pathname };
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) { if (p.get(k)) a[k] = p.get(k); });
          if (document.referrer && new URL(document.referrer).hostname.replace(/^www\./, '') !== location.hostname.replace(/^www\./, '')) a.referrer = document.referrer;
          sessionStorage.setItem('ck_attr', JSON.stringify(a));
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <PrintFrame position="head" />
    <main id="main"><slot /></main>
    <PrintFrame position="foot" />
    <FloatingActions />
    <Footer />
    {ANALYTICS_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>
    )}
  </body>
</html>
