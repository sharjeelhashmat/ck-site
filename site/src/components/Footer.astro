---
import NewsletterSignup from './NewsletterSignup.astro';
import { SITE, AFFILIATION_LINE, PERMIT_LINE } from '../lib/site';
import { LEAD_CAPTURE } from '../lib/golive';
// Go-live lines (golive.ts): nothing renders while a value is empty. Soft launch (LEAD_CAPTURE false): no newsletter
// sign-up and no Privacy or Terms links (those pages are not built); phone and email stay.
const disclosure = [AFFILIATION_LINE, PERMIT_LINE].filter(Boolean).join(' · ');
const year = new Date().getFullYear();
const social = [
  { name: 'LinkedIn', href: SITE.linkedin },
  { name: 'Instagram', href: SITE.instagram },
  { name: 'Facebook', href: SITE.facebook },
];
---
<footer class="site-footer">
  <div class="wrap">
    {LEAD_CAPTURE && <NewsletterSignup source="footer" />}
    <div class="foot-row">
      {/* Brand Package lockup (owner 2026-11-07, Rules 1c v6.9): the approved logo-horizontal-ivory.svg exactly as
          delivered (compass-key mark, "Sharjeel Hashmat" in Ivory serif, the Brass rule, "PROPERTY CONSULTANT · UAE" in
          Brass spaced capitals), on Ink. CSS only crops the empty canvas around it (global.css, footer lockup). Its tagline
          must be at least 10px tall (Coordinator note 2026-11-07), so it shows at 656px wide, on screens 704px and wider.
          The Brand Package has no stacked lockup for narrower screens; until it does, they keep the stacked footer lockup
          below (owner 2026-11-07, PR 109). */}
      <div class="brand brand-lockup">
        <img class="lockup" src="/logo-horizontal-ivory.svg" alt={`${SITE.name}, ${SITE.title} · UAE`} width="2880" height="960" />
      </div>
      {/* Stacked lockup (owner 2026-11-07): the title on its own line under the wordmark, starting where the "Sharjeel
          Hashmat" text starts, with the mark centred against both lines. The approved logo file is shown twice, cropped by
          CSS (global.css, footer lockup): once for the mark, once for the wordmark. The file itself is unchanged. */}
      <div class="brand brand-stacked">
        <div class="brand-mark" aria-hidden="true"><img class="logo" src="/logo-web-ivory.svg" alt="" width="224" height="46" /></div>
        <div class="brand-word"><img class="logo" src="/logo-web-ivory.svg" alt="Sharjeel Hashmat" width="224" height="46" /></div>
        <span>{SITE.title} · UAE</span>
      </div>
      <div class="social">
        <span class="social-label">Follow</span>
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={`${SITE.name} on ${s.name}`}>{s.name}</a>
        ))}
      </div>
    </div>
    <div class="foot-row">
      <span class="small">© {year} {SITE.name} · All rights reserved</span>
      <div class="foot-links">
        <a href={`tel:+${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href="/faq">FAQ</a>
        {LEAD_CAPTURE && <a href="/privacy">Privacy</a>}
        {LEAD_CAPTURE && <a href="/terms">Terms</a>}
      </div>
    </div>
    {disclosure && <p class="disclosure">{disclosure}</p>}
  </div>
</footer>
