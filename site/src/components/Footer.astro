---
import NewsletterSignup from './NewsletterSignup.astro';
import { SITE, AFFILIATION_LINE } from '../lib/site';
const year = new Date().getFullYear();
const social = [
  { name: 'LinkedIn', href: SITE.linkedin },
  { name: 'Instagram', href: SITE.instagram },
  { name: 'Facebook', href: SITE.facebook },
];
---
<footer class="site-footer">
  <div class="wrap">
    <NewsletterSignup source="footer" />
    <div class="foot-row">
      <div class="brand">
        <img class="logo" src="/logo-web-ivory.svg" alt="Sharjeel Hashmat" width="224" height="46" />
        <span>{SITE.title} · UAE</span>
      </div>
      <div class="social">
        <span class="social-label">Follow</span>
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={`${SITE.name} on ${s.name}`}>{s.name}</a>
        ))}
      </div>
    </div>
    <div class="foot-row">
      <span class="small">© {year} {SITE.name} · All rights reserved</span>
      <div class="foot-links">
        <a href={`tel:+${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href="/faq">FAQ</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
    {AFFILIATION_LINE && <p class="disclosure">{AFFILIATION_LINE}</p>}
  </div>
</footer>
