---
import { NAV_LINKS, SITE, waLink } from '../lib/site';
// build.format is 'file', so a page's URL at build time ends in .html (/buy.html); strip it before matching.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const wa = waLink("Hi Sharjeel, I'm interested in UAE real estate.");
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
// One <nav> serves desktop and mobile (the mobile menu is the same element shown as a panel), so each page carries
// exactly one aria-current link. Groups: segmented Buy | Invest | Sell, outlined pills, plain links, WhatsApp.
const pick = (hrefs: string[]) => NAV_LINKS.filter((l) => hrefs.includes(l.href));
const segment = pick(['/buy', '/invest', '/sell']);
const pills = pick(['/areas', '/new-launches', '/insights']);
const plain = pick(['/about', '/contact']);
---
<header class="site-nav">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <img class="logo" src="/logo-web-ivory.svg" alt="Sharjeel Hashmat" width="253" height="52" />
    </a>
    <!-- The button comes before the menu so Tab moves from it straight into the open panel. -->
    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" id="menu-btn">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-menu" id="site-menu" aria-label="Primary">
      <div class="nav-seg">
        {segment.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      </div>
      <div class="nav-pills">
        {pills.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      </div>
      <div class="nav-plain">
        {plain.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      </div>
      <a class="nav-wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
    </nav>
  </div>
</header>
<script>
  import { pageBehind, wrapFocus } from '../lib/menu-focus.mjs';
  const btn = document.getElementById('menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('site-menu');
  const header = btn?.closest('header') ?? null;
  // The menu is a panel only below 75rem (1200px); at desktop width the button is hidden and nothing here applies.
  const desktop = window.matchMedia('(min-width: 75rem)');
  const items = () => [...(menu?.querySelectorAll<HTMLElement>('a') ?? [])];
  const isOpen = () => !!menu?.classList.contains('open');
  let inerted: Element[] = [];
  function set(open: boolean, returnFocus = false) {
    menu?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) {
      // The page behind is inert only while the menu is open.
      inerted = pageBehind([...document.body.children], header);
      inerted.forEach((el) => el.setAttribute('inert', ''));
      items()[0]?.focus();
    } else {
      inerted.forEach((el) => el.removeAttribute('inert'));
      inerted = [];
      if (returnFocus) btn?.focus();
    }
  }
  btn?.addEventListener('click', () => set(!isOpen()));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => {
    if (!isOpen() || !btn) return;
    if (e.key === 'Escape') { set(false, true); return; }
    if (e.key !== 'Tab') return;
    const target = wrapFocus({ shift: e.shiftKey, active: document.activeElement as HTMLElement | null, button: btn as HTMLElement, items: items() });
    if (target) { e.preventDefault(); target.focus(); }
  });
  desktop.addEventListener('change', (e) => { if (e.matches && isOpen()) set(false); });
</script>
