---
import { waLink } from '../lib/site';
import { LEAD_CAPTURE } from '../lib/golive';
const fields = [
  ['budget', 'Purchase Price (AED)', 1500000],
  ['expectedAnnualRent', 'Expected Annual Rent (AED)', 105000],
  ['annualServiceCharges', 'Annual Service Charges (AED)', 15000],
  ['holdingPeriodYears', 'Holding Period (years)', 5],
  ['acquisitionCostPct', 'Acquisition Costs (% of price)', 7],
  // 0 by default (owner rule, 2026-11-08: no price predictions; any growth is the visitor's own assumption).
  ['expectedAnnualAppreciationPct', 'Expected Annual Appreciation (%)', 0],
] as const;
const stats = [
  ['grossYieldPct', 'Gross Yield'], ['netYieldPct', 'Net Yield'], ['annualNetIncome', 'Annual Net Income'],
  ['acquisitionCosts', 'Acquisition Costs'], ['projectedExitValue', 'Projected Exit Value'], ['annualizedReturnPct', 'Annualised return (IRR)'],
] as const;
---
<div class="card" id="roi">
  <h2>ROI calculator</h2>
  <p class="small">A quick, directional estimate, not a substitute for a property-specific analysis.</p>
  <div class="fields" style="margin-top:var(--space-6)">
    {fields.map(([k, label, v]) => (
      <div class="field">
        <label for={`roi-${k}`}>{label}</label>
        <input id={`roi-${k}`} data-k={k} type="number" inputmode="decimal" value={v} min="0" step="any" />
      </div>
    ))}
  </div>
  <div class="grid grid--3" style="margin-top:var(--space-8);padding-top:var(--space-6);border-top:1px solid var(--line)">
    {stats.map(([k, label]) => (
      <div><div class="stat" data-out={k}>…</div><div class="stat-label">{label}</div></div>
    ))}
  </div>
  <!-- One polite announcement per change (audit item 24), not six: the grid itself is not live. -->
  <p class="sr-only" aria-live="polite" data-live></p>
  <p class="fine" style="margin-top:var(--space-6)">Estimate only, based on the figures you entered. Not financial, tax or legal advice, and not a guarantee of actual performance. Appreciation and rental figures are assumptions you control above, not market forecasts from Sharjeel.</p>
  {LEAD_CAPTURE && <a class="btn" style="margin-top:var(--space-6)" href={waLink('Hi Sharjeel, I ran some numbers on the ROI calculator and would like your view on a specific property.')} target="_blank" rel="noopener">Discuss this with Sharjeel</a>}
</div>
<script>
  import { computeROI, formatAED, formatPct, type ROIInputs } from '../lib/roi';
  const root = document.getElementById('roi')!;
  const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
  const pct = new Set(['grossYieldPct', 'netYieldPct', 'annualizedReturnPct']);
  const live = root.querySelector<HTMLElement>('[data-live]')!;
  function run(announce = true) {
    const v = {} as Record<string, number>;
    for (const i of inputs) { const n = Number(i.value); v[i.dataset.k!] = Number.isFinite(n) ? n : 0; }
    const r = computeROI(v as unknown as ROIInputs);
    root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
      const k = el.dataset.out as keyof typeof r;
      el.textContent = pct.has(k) ? formatPct(r[k]) : formatAED(r[k] as number);
    });
    if (announce) live.textContent = `Net yield ${formatPct(r.netYieldPct)}`;
  }
  inputs.forEach((i) => i.addEventListener('input', () => run()));
  run(false);
</script>
