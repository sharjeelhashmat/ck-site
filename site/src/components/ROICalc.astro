---
import { waLink } from '../lib/site';
const fields = [
  ['budget', 'Purchase Price (AED)', 1500000],
  ['expectedAnnualRent', 'Expected Annual Rent (AED)', 105000],
  ['annualServiceCharges', 'Annual Service Charges (AED)', 15000],
  ['holdingPeriodYears', 'Holding Period (years)', 5],
  ['acquisitionCostPct', 'Acquisition Costs (% of price)', 7],
  ['expectedAnnualAppreciationPct', 'Expected Annual Appreciation (%)', 3],
] as const;
const stats = [
  ['grossYieldPct', 'Gross Yield'], ['netYieldPct', 'Net Yield'], ['annualNetIncome', 'Annual Net Income'],
  ['acquisitionCosts', 'Acquisition Costs'], ['projectedExitValue', 'Projected Exit Value'], ['annualizedReturnPct', 'Annualized Return'],
] as const;
---
<div class="card" id="roi">
  <p class="kicker" style="margin:0">ROI Calculator</p>
  <p class="small">A quick, directional estimate — not a substitute for the property-specific analysis in a Compass Key Brief once a listing is attached to it.</p>
  <div class="fields" style="margin-top:1.5rem">
    {fields.map(([k, label, v]) => (
      <div class="field">
        <label for={`roi-${k}`}>{label}</label>
        <input id={`roi-${k}`} data-k={k} type="number" inputmode="decimal" value={v} min="0" step="any" />
      </div>
    ))}
  </div>
  <div class="grid grid--3" style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--line)" aria-live="polite">
    {stats.map(([k, label]) => (
      <div><div class="stat" data-out={k}>–</div><div class="stat-label">{label}</div></div>
    ))}
  </div>
  <p class="fine" style="margin-top:1.5rem">Estimate only, based on the figures you entered — not financial, tax or legal advice, and not a guarantee of actual performance. Appreciation and rental figures are assumptions you control above, not market forecasts from Sharjeel.</p>
  <a class="btn" style="margin-top:1.25rem" href={waLink('Hi Sharjeel, I ran some numbers on the ROI calculator and would like your view on a specific property.')} target="_blank" rel="noopener">Discuss this with Sharjeel</a>
</div>
<script>
  import { computeROI, formatAED, formatPct, type ROIInputs } from '../lib/roi';
  const root = document.getElementById('roi')!;
  const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
  const pct = new Set(['grossYieldPct', 'netYieldPct', 'annualizedReturnPct']);
  function run() {
    const v = {} as Record<string, number>;
    for (const i of inputs) { const n = Number(i.value); v[i.dataset.k!] = Number.isFinite(n) ? n : 0; }
    const r = computeROI(v as unknown as ROIInputs);
    root.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
      const k = el.dataset.out as keyof typeof r;
      el.textContent = pct.has(k) ? formatPct(r[k]) : formatAED(r[k]);
    });
  }
  inputs.forEach((i) => i.addEventListener('input', run));
  run();
</script>
