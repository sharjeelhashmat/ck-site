---
// The data card component (Rules 1c v6.9, "Brand data standard"): the build-time face of lib/chart.mjs. Pages pass
// the markup the lib functions return (renderTop, renderChange, renderGuideCard, renderTableCards), and the browser
// calls the same functions for the figures it loads, so a card looks the same wherever and whenever it is drawn. The
// look is defined once, in styles/data-card.css, which this component brings with it.
import '../styles/data-card.css';
interface Props { html: string }
const { html } = Astro.props;
---
<Fragment set:html={html} />
