---
// One form component, three modes: general (/contact), sell (/sell) and launch (the /new-launches question form). All post
// to the lead Worker (POST /lead) with a Turnstile token. Field names and enums match worker/src/types.ts and
// worker/src/firewall.ts exactly. Launch sends intent "invest" (owner decision 2026-10-10) and no budget, timeline,
// funding or country; its project and question travel in the message (lib/lead-submit.mjs composeMessage).
import { INTENTS, SITE, waLink } from '../lib/site';
import { PROFILE_ENABLED, PROFILE_INTENTS } from '../lib/profile';
import { dialCodes } from '../lib/phone.mjs';
import { BOX_MAX, CONTACT_CHOICES } from '../lib/lead-submit.mjs';
interface Props { mode?: 'general' | 'sell' | 'launch'; defaultIntent?: string; submitLabel?: string }
const { mode = 'general', defaultIntent = 'buy', submitLabel = 'Send' } = Astro.props;
const sell = mode === 'sell';
const launch = mode === 'launch';
const general = mode === 'general';
// Country-code select for the mobile number (all countries; default United Arab Emirates +971).
const dials = dialCodes();
const defaultDial = dials.find((d) => d.cc === 'AE')?.dial ?? '971';
const countries = [
  ['AE', 'United Arab Emirates'], ['PK', 'Pakistan'], ['GB', 'United Kingdom'], ['IN', 'India'], ['SA', 'Saudi Arabia'],
  ['QA', 'Qatar'], ['KW', 'Kuwait'], ['OM', 'Oman'], ['BH', 'Bahrain'], ['US', 'United States'], ['CA', 'Canada'],
  ['AU', 'Australia'], ['DE', 'Germany'], ['FR', 'France'], ['CN', 'China'], ['', 'Other'],
];
---
<form class="card" id="lead-form" novalidate data-worker={SITE.workerUrl} data-mode={mode} data-default-intent={defaultIntent} data-profile={PROFILE_ENABLED ? PROFILE_INTENTS.join(',') : undefined}>
  <div class="fields">
    <div class="field">
      <label for="f-name">Name</label>
      <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby="f-name-err" />
      <span class="err" id="f-name-err" data-err="name"></span>
    </div>
    <div class="field">
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="f-email-err" />
      <span class="err" id="f-email-err" data-err="email"></span>
    </div>
    <div class="field">
      <label for="f-phone">Mobile number (with country code)</label>
      <div class="phone-row">
        <div class="cc-control">
          <span class="cc-display" id="f-phone-cc-display" aria-hidden="true"><span class="cc-code">+{defaultDial}</span><svg class="cc-chevron" viewBox="0 0 12 8" width="12" height="8" focusable="false"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></span>
          <select id="f-phone-cc" name="phone_country" aria-label="Country code" required>
            {dials.map((d) => <option value={d.cc} data-dial={d.dial} selected={d.cc === 'AE'}>{`${d.name} (+${d.dial})`}</option>)}
          </select>
        </div>
        <input id="f-phone" name="phone_national" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="50 123 4567" maxlength="24" required aria-describedby="f-phone-err" />
      </div>
      <span class="err" id="f-phone-err" data-err="phone"></span>
    </div>
    <fieldset class="field pref">
      <legend class="lbl">Preferred contact</legend>
      <div class="pills">
        {CONTACT_CHOICES.map((c) => <label class="pill"><input type="radio" name="preferred_contact" value={c.value} required aria-describedby="f-pref-err" /><span>{c.label}</span></label>)}
      </div>
      <span class="err" id="f-pref-err" data-err="preferred_contact"></span>
    </fieldset>
    {!launch && (
      <div class="field">
        <label for="f-country">Where are you based?</label>
        <select id="f-country" name="country" autocomplete="country">
          <option value="">Select</option>
          {countries.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </div>
    )}
    {sell ? (
      <input type="hidden" name="intent" value="sell" />
    ) : launch ? (
      <input type="hidden" name="intent" value="invest" />
    ) : (
      <div class="field">
        <label for="f-intent">What are you looking to do?</label>
        <select id="f-intent" name="intent">
          {INTENTS.map((i) => <option value={i.value}>{i.label}</option>)}
        </select>
      </div>
    )}
    {general && (
      <div class="field">
        <label for="f-budget">Budget (optional)</label>
        <select id="f-budget" name="budget_band">
          <option value="unspecified">Prefer not to say</option>
          <option value="under_1m">Under AED 1M</option>
          <option value="1m_2m">AED 1M – 2M</option>
          <option value="2m_5m">AED 2M – 5M</option>
          <option value="over_5m">Over AED 5M</option>
        </select>
      </div>
    )}
    {!launch && (
      <div class="field">
        <label for="f-timeline">Timeline</label>
        <select id="f-timeline" name="timeline">
          <option value="exploring">Just exploring</option>
          <option value="now">Now</option>
          <option value="3m">Within 3 months</option>
          <option value="6m">Within 6 months</option>
          <option value="12m_plus">12 months or later</option>
        </select>
      </div>
    )}
    {general && (
      <div class="field">
        <label for="f-funding">Funding (optional)</label>
        <select id="f-funding" name="funding">
          <option value="unsure">Not sure yet</option>
          <option value="cash">Cash</option>
          <option value="mortgage">Mortgage</option>
        </select>
      </div>
    )}
    {sell && (
      <>
        <div class="field"><label for="s-location">Location / community</label><input id="s-location" name="s_location" type="text" maxlength="60" /></div>
        <div class="field"><label for="s-project">Project / building</label><input id="s-project" name="s_project" type="text" maxlength="60" /></div>
        <div class="field"><label for="s-type">Property type</label><input id="s-type" name="s_type" type="text" placeholder="Apartment, villa, townhouse…" maxlength="40" /></div>
        <div class="field"><label for="s-bed">Bedrooms</label><input id="s-bed" name="s_bed" type="text" maxlength="10" /></div>
        <div class="field"><label for="s-size">Size (sq ft)</label><input id="s-size" name="s_size" type="text" maxlength="12" /></div>
        <div class="field">
          <label for="s-occ">Occupancy</label>
          <select id="s-occ" name="s_occ"><option>Vacant</option><option>Tenanted</option><option>Owner-occupied</option></select>
        </div>
        <div class="field"><label for="s-price">Expected price, AED (optional)</label><input id="s-price" name="s_price" type="text" maxlength="20" /></div>
      </>
    )}
    {launch ? (
      <>
        <div class="field full">
          <label for="f-project">Project name (optional)</label>
          <input id="f-project" name="project" type="text" maxlength="120" placeholder="e.g. the project or developer name" autocomplete="off" />
        </div>
        <div class="field full">
          <label for="f-question">Your question</label>
          <textarea id="f-question" name="question" rows="4" required placeholder="e.g. Is the payment plan on this launch fair for a 2-bed?" aria-describedby="f-question-err"></textarea>
          <span class="err" id="f-question-err" data-err="question"></span>
        </div>
      </>
    ) : (
      <div class="field full">
        <label for="f-message">{sell ? 'Anything else' : 'Tell me more'}</label>
        <textarea id="f-message" name="message" maxlength={BOX_MAX} placeholder={sell ? 'Reason for selling, timing, anything useful' : 'Objective, location preference, anything else useful'} aria-describedby="f-message-err"></textarea>
        <span class="err" id="f-message-err" data-err="message"></span>
      </div>
    )}
  </div>

  <div class="hp" aria-hidden="true"><label>Website <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label></div>

  <div style="display:grid;gap:.75rem;margin-top:1.25rem">
    <label class="check"><input type="checkbox" id="f-consent" name="consent_contact" required aria-describedby="f-consent-err" /><span>I agree that {SITE.name} may contact me about my enquiry using the details above. <a href="/privacy">Privacy</a></span></label>
    <span class="err" id="f-consent-err" data-err="consent_contact" style="color:var(--err);font-size:.8rem"></span>
    <label class="check"><input type="checkbox" name="consent_nurture" /><span>Send me the occasional market note. I can unsubscribe at any time. (Optional)</span></label>
  </div>

  <div class="turnstile" id="lead-turnstile" data-sitekey={SITE.turnstileSiteKey}></div>
  <span class="err lead-err" id="lead-turnstile-err" data-err="turnstile" role="alert"></span>

  <div class="form-foot">
    <button class="btn" type="submit" id="lead-submit">{submitLabel}</button>
    <span class="status" id="lead-status" role="status" aria-live="polite"></span>
  </div>
  <div class="lead-alert" id="lead-alert" role="alert"></div>
  <template id="lead-alert-tpl"><p>Your message could not be sent. Please try again, or contact me directly on <a href={waLink("Hi Sharjeel, I'd like to discuss UAE real estate.")} target="_blank" rel="noopener">WhatsApp</a> or at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p></template>
  {PROFILE_ENABLED && <p class="fine" id="lead-next" hidden style="margin-top:1rem"></p>}
  {/* Launch mode keeps no WhatsApp link outside the failure alert (owner decision 2026-10-10, tests/enquiry-forms.test.mjs);
     there, the alert below (also shown when the security check cannot load) is the WhatsApp route. */}
  {!launch && <p class="fine" style="margin-top:1rem">Prefer WhatsApp? <a href={waLink("Hi Sharjeel, I'd like to discuss UAE real estate.")} target="_blank" rel="noopener">Message me directly</a> or call {SITE.phoneDisplay}.</p>}
</form>

<style is:global>
  /* Submit outcomes (existing tokens; ok and err pass AA on the white card). */
  .lead-err { display: block; color: var(--err); font-size: .875rem; margin-top: .5rem; }
  .lead-err:empty { display: none; }
  .lead-alert:not(:empty) { margin-top: 1rem; padding: .9rem 1rem; border-radius: var(--r-card); background: var(--paper); border: 1px solid var(--err); border-left-width: 3px; color: var(--err); font-size: .95rem; }
  .lead-alert p { margin: 0; }
  .lead-alert a { color: var(--err); }
  /* scroll-margin keeps the panel clear of the fixed header when focus moves to it. */
  .lead-success { border-left: 3px solid var(--ok); scroll-margin-top: 6rem; }
  .lead-success > p:first-child { margin: 0; color: var(--ok); font-size: 1.05rem; font-weight: 500; }
  /* Preferred contact: three pill radios. The native radios stay in the page (visually hidden, still focusable and
     announced); the pill shows the state. Ink on white, selected Ink with Ivory text, the site's focus ring. */
  .pref { border: 0; padding: 0; margin: 0; min-width: 0; }
  .pref legend { padding: 0; margin-bottom: .4rem; }
  .pref .pills { display: flex; flex-wrap: wrap; gap: .5rem; }
  .pref .pill { position: relative; display: inline-flex; text-transform: none; letter-spacing: normal; font-size: .95rem; font-weight: 500; color: var(--ink); }
  .pref .pill input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; opacity: 0; cursor: pointer; }
  .pref .pill span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.15rem; border: 1px solid var(--ink); border-radius: var(--r-pill); background: var(--paper); color: var(--ink); transition: background .15s, color .15s; }
  .pref .pill input:checked + span { background: var(--ink); color: var(--ivory); }
  .pref .pill input:focus-visible + span { outline: 3px solid var(--navy); outline-offset: 3px; }
  /* Invalid fields (audit H13): the existing error colour on the control's own border. */
  .pref .pill input[aria-invalid='true'] + span { border-color: var(--err); }
</style>

<script>
  import { attributionFields } from '../lib/attribution.mjs';
  import { sendLead, successText, turnstileGate, validateLead } from '../lib/lead-submit.mjs';
  import { turnstileLoader } from '../lib/turnstile.mjs';
  type Turnstile = {
    render: (el: HTMLElement, o: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };
  type PhoneLib = typeof import('../lib/phone.mjs');
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('lead-status')!;
    const btn = document.getElementById('lead-submit') as HTMLButtonElement;
    const mode = (form.dataset.mode ?? 'general') as 'general' | 'sell' | 'launch';
    const sell = mode === 'sell';
    const launch = mode === 'launch';
    const workerUrl = form.dataset.worker!;
    const alertBox = document.getElementById('lead-alert')!;
    const alertTpl = document.getElementById('lead-alert-tpl') as HTMLTemplateElement;
    const sendLabel = btn.textContent ?? 'Send';
    const showAlert = () => alertBox.replaceChildren(alertTpl.content.cloneNode(true));

    // Preselect intent from ?intent=
    const q = new URLSearchParams(location.search).get('intent');
    const sel = form.elements.namedItem('intent') as HTMLSelectElement | null;
    const want = q ?? form.dataset.defaultIntent;
    if (sel && sel.tagName === 'SELECT' && want && [...sel.options].some((o) => o.value === want)) sel.value = want;

    const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    const choiceOf = () => form.querySelector<HTMLInputElement>('input[name="preferred_contact"]:checked')?.value ?? '';

    // The phone library (libphonenumber) loads on the first input into the number, or on Send, never with the page.
    let phoneLib: Promise<PhoneLib> | null = null;
    const loadPhone = () => (phoneLib ??= import('../lib/phone.mjs').catch((e: unknown) => { phoneLib = null; throw e; }));
    let toE164: PhoneLib['toE164'] | null = null;
    form.querySelector('#f-phone')?.addEventListener('input', () => { loadPhone().then((m) => { toE164 = m.toE164; }, () => {}); }, { once: true });

    // Turnstile renders explicitly on the form's first focusin (like the newsletter signup), not with the page.
    const loadTurnstile = turnstileLoader();
    let widgetErrored = false;
    let widget: Promise<{ t: Turnstile; id: string }> | null = null;
    const ensureWidget = () => {
      widget ??= loadTurnstile()
        .then((t: Turnstile) => {
          const box = form.querySelector<HTMLElement>('#lead-turnstile')!;
          const id = t.render(box, {
            sitekey: box.dataset.sitekey, theme: 'light', appearance: 'always',
            callback: () => { widgetErrored = false; },
            'error-callback': () => { widgetErrored = true; },
          });
          return { t, id };
        })
        .catch((e: unknown) => { widget = null; throw e; });
      return widget;
    };
    form.addEventListener('focusin', () => { ensureWidget().catch(() => {}); }, { once: true });

    // Inline errors (audit H13): the message sits in the field's own error span (aria-describedby), the control gets
    // aria-invalid, focus goes to the first invalid field, and the status line announces the summary.
    const controls = (field: string): HTMLElement[] => {
      if (field === 'preferred_contact') return [...form.querySelectorAll<HTMLElement>('input[name="preferred_contact"]')];
      const el = form.querySelector<HTMLElement>(field === 'phone' ? '#f-phone' : `[name="${field}"]`);
      return el ? [el] : [];
    };
    const invalid = new Set<string>();
    const setErr = (field: string, msg: string) => {
      const el = form.querySelector(`[data-err="${field}"]`);
      if (el) el.textContent = msg;
      if (field === 'turnstile') return;
      for (const c of controls(field)) c.setAttribute('aria-invalid', 'true');
      invalid.add(field);
    };
    const clearErr = (field: string) => {
      const el = form.querySelector(`[data-err="${field}"]`);
      if (el) el.textContent = '';
      for (const c of controls(field)) c.removeAttribute('aria-invalid');
      invalid.delete(field);
    };
    const clearErrs = () => {
      form.querySelectorAll('[data-err]').forEach((e) => (e.textContent = ''));
      form.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
      invalid.clear();
      alertBox.replaceChildren();
    };
    const focusField = (field: string) => controls(field)[0]?.focus();
    const values = () => {
      const ccSel = form.elements.namedItem('phone_country') as HTMLSelectElement;
      return {
        name: val('name'), email: val('email'), national: val('phone_national'), country: ccSel.value,
        countryLabel: ccSel.selectedOptions[0]?.text ?? '', choice: choiceOf(), message: val('message'), project: val('project'),
        question: val('question'), consent: (form.elements.namedItem('consent_contact') as HTMLInputElement).checked,
        sellParts: sell ? [['Location', val('s_location')], ['Project', val('s_project')], ['Type', val('s_type')], ['Bedrooms', val('s_bed')],
          ['Size sq ft', val('s_size')], ['Occupancy', val('s_occ')], ['Expected AED', val('s_price')]] as [string, string][] : undefined,
      };
    };
    // A shown error goes away as soon as that field is fixed (re-checked on each edit).
    const fieldOf = (t: EventTarget | null) => {
      const el = t as HTMLInputElement | null;
      if (!el?.name) return '';
      if (el.name === 'phone_national' || el.name === 'phone_country') return 'phone';
      return el.name;
    };
    const recheck = (e: Event) => {
      const field = fieldOf(e.target);
      if (!invalid.has(field) || (field === 'phone' && !toE164)) return;
      const { problems } = validateLead(mode, values(), toE164 ?? (() => null));
      if (!problems.some(([k]) => k === field)) clearErr(field);
    };
    form.addEventListener('input', recheck);
    form.addEventListener('change', recheck);

    // The closed country-code control shows only the dial code; the native select sits over it (opacity 0).
    const ccSelect = form.querySelector<HTMLSelectElement>('#f-phone-cc');
    const ccCode = form.querySelector<HTMLElement>('#f-phone-cc-display .cc-code');
    const showDial = () => { if (ccSelect && ccCode) ccCode.textContent = `+${ccSelect.selectedOptions[0]?.dataset.dial ?? ''}`; };
    ccSelect?.addEventListener('change', showDial);
    form.addEventListener('reset', () => setTimeout(showDial));
    showDial();
    const say = (msg: string, ok: boolean) => { status.textContent = msg; status.className = 'status ' + (ok ? 'ok' : 'bad'); };

    let attribution: Record<string, string | null> = {};
    try { attribution = JSON.parse(sessionStorage.getItem('ck_attr') ?? '{}'); } catch { /* storage unavailable */ }

    const busy = (on: boolean, label = 'Sending…') => {
      btn.disabled = on; btn.textContent = on ? label : sendLabel;
      if (on) form.setAttribute('aria-busy', 'true'); else form.removeAttribute('aria-busy');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn.disabled) return;
      clearErrs(); status.textContent = '';
      const v = values();

      busy(true);
      let phoneCheck: PhoneLib['toE164'];
      try { phoneCheck = (await loadPhone()).toE164; toE164 = phoneCheck; } catch { busy(false); showAlert(); return; }
      const { problems, phone, message } = validateLead(mode, v, phoneCheck);
      if (problems.length) {
        busy(false);
        for (const [field, msg] of problems) setErr(field, msg);
        say('Please fix the highlighted fields.', false);
        focusField(problems[0][0]);
        return;
      }

      // The security check: if it never loaded (blocked, failed, timed out) the visitor gets WhatsApp and email instead.
      let ts: { t: Turnstile; id: string } | null = null;
      try { ts = await ensureWidget(); } catch { ts = null; }
      const token = ts ? ts.t.getResponse(ts.id) ?? '' : '';
      const gate = turnstileGate({ loaded: !!ts, errored: widgetErrored, token });
      if (gate !== 'send') {
        busy(false);
        if (gate === 'fallback') showAlert();
        else say('Please wait for the security check to finish, then send again.', false);
        return;
      }

      const payload = {
        name: v.name, email: v.email,
        phone,
        country: val('country') || undefined,
        intent: sell ? 'sell' : launch ? 'invest' : val('intent') || 'buy',
        budget_band: mode === 'general' ? val('budget_band') || 'unspecified' : undefined,
        timeline: launch ? undefined : val('timeline') || 'exploring',
        funding: mode === 'general' ? val('funding') || 'unsure' : undefined,
        message,
        consent_contact: true,
        consent_nurture: (form.elements.namedItem('consent_nurture') as HTMLInputElement).checked,
        company_website: val('company_website'),
        turnstile_token: token,
        ...attributionFields(attribution, location.pathname, document.referrer),
      };

      // Sending: the button says so and the form is busy until exactly one outcome is shown.
      const outcome = await sendLead(`${workerUrl}/lead`, payload);
      form.removeAttribute('aria-busy');

      if (outcome.kind === 'success') {
        // Replace the form with the confirmation, and move focus to it.
        const panel = document.createElement('div');
        panel.className = 'card lead-success';
        panel.setAttribute('role', 'status');
        panel.tabIndex = -1;
        const p = document.createElement('p');
        p.textContent = successText(launch ? 'question' : 'enquiry', v.choice);
        panel.append(p);
        // Optional step 2: only when the feature is switched on, and only for enquiries where a profile helps.
        const profileIntents = (form.dataset.profile ?? '').split(',').filter(Boolean);
        if (document.getElementById('lead-next') && outcome.id && /^[0-9a-f-]{36}$/i.test(outcome.id) && profileIntents.includes(payload.intent)) {
          const a = document.createElement('a');
          a.href = `/investor-profile?lead=${encodeURIComponent(outcome.id)}`;
          a.textContent = 'Optional: answer five short questions so I can match properties to you.';
          const next = document.createElement('p');
          next.className = 'fine';
          next.append(a);
          panel.append(next);
        }
        form.replaceWith(panel);
        panel.focus();
        return;
      }

      // Every other outcome keeps the visitor's input, explains itself and lets them send again.
      if (outcome.kind === 'field') {
        setErr(outcome.field, outcome.message);
        say('Please check the form and try again.', false);
        focusField(outcome.field);
      } else if (outcome.kind === 'verification') {
        setErr('turnstile', outcome.message);
      } else {
        showAlert();
      }
      if (outcome.resetTurnstile) ts!.t.reset(ts!.id);
      if (outcome.enableSend) busy(false);
    });
  }
</script>
