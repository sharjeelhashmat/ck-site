---
import Base from '../layouts/Base.astro';
import ROICalc from '../components/ROICalc.astro';
import { METHOD } from '../lib/method';
---
<Base title="Invest in UAE Real Estate" description="Evaluate UAE property investments on price, rental demand, net yield, supply, payment structure and exit — not on brochure promises.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Invest</p>
      <h1 style="max-width:18ch">Evaluate the opportunity. <em>Then decide.</em></h1>
      <p class="lede">UAE real estate can offer strong returns — but not every listing is a good investment, and blanket numbers you see quoted elsewhere rarely apply to your specific property. Every recommendation I make is qualified against six factors. <a href="/investment-approach">See how I work through them.</a></p>

      <div class="grid grid--2" style="margin-top:2.5rem">
        {METHOD.map((m) => (
          <div class="card"><h2 style="font-size:1.25rem;font-family:var(--sans);font-weight:600">{m.title}</h2><p>{m.desc}</p></div>
        ))}
      </div>

      <div style="margin-top:2.5rem"><ROICalc /></div>

      <div class="card" style="margin-top:2.5rem">
        <h3 style="color:var(--navy)">UAE Market Intelligence</h3>
        <p style="max-width:36rem">Transaction activity, pricing trends, rental market movement and new launch supply — tracked and interpreted, not just reported. Full market updates land with the Insights section.</p>
      </div>

      <div class="actions"><a class="btn" href="/contact?intent=invest">Get my investment shortlist</a></div>
    </div>
  </section>
</Base>
