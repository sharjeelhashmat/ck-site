---
import Base from '../layouts/Base.astro';
import { asSentence, FIVE_CHECKS } from '../lib/checks';
import ROICalc from '../components/ROICalc.astro';
import { LEAD_CAPTURE } from '../lib/golive';
---
<Base title="Invest in UAE Real Estate" description="Evaluate UAE property investments through five checks: price, returns, risk, exit, and my view. Not brochure promises.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Invest</p>
      <h1 style="max-width:18ch">Evaluate the opportunity. <em>Then decide.</em></h1>
      <p class="lede">UAE real estate can offer strong returns, but not every listing is a good investment, and blanket numbers you see quoted elsewhere rarely apply to your specific property. Every recommendation I make goes through the same five checks. <a href="/investment-approach">See how I work through them.</a></p>

      {/* The five checks (owner 2026-11-08): card headings in the site's card heading style (Cormorant, as the Buy cards);
          one row of five on desktop, three then two centred on a tablet, stacked on a phone (global.css, .checks-grid). */}
      <div class="checks-grid" style="margin-top:var(--space-12)">
        {FIVE_CHECKS.map((c) => <div class="card"><h2>{c.name}</h2><p>{asSentence(c.text)}</p></div>)}
      </div>

      <div style="margin-top:var(--space-12)"><ROICalc /></div>

      <div class="card" style="margin-top:var(--space-12)">
        <h3 style="color:var(--navy)">UAE Market Intelligence</h3>
        <p style="max-width:36rem">Transaction activity, pricing trends, rental market movement and new launch supply: tracked and interpreted, not just reported. Full market updates are in <a href="/insights">Insights</a>.</p>
      </div>

      {LEAD_CAPTURE && <div class="actions"><a class="btn" href="/contact?intent=invest">Get my investment shortlist</a></div>}
    </div>
  </section>
</Base>
