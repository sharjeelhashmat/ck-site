---
import Base from '../layouts/Base.astro';
import { BLURBS, INTENTS, waLink } from '../lib/site';
const intents = INTENTS.filter((i) => i.value !== 'other');
// The four ways: number, audience label and a generic line icon per intent (Brand v3.1; labels owner-approved 2026-10-10).
// Cards 2 and 3 are Ink, so the 2-column grid reads as a checkerboard.
const WAYS: Record<string, { n: string; label: string; icon: string }> = {
  buy: { n: '01', label: 'For homebuyers', icon: '<path d="M5 15 16 6l11 9"/><path d="M8 13v13h16V13"/><path d="M13.5 26v-7h5v7"/>' },
  invest: { n: '02', label: 'For investors', icon: '<path d="M5 26h22"/><path d="m6 21 6-6 4.5 3.5L26 9"/><path d="M20 9h6v6"/>' },
  sell: { n: '03', label: 'For owners', icon: '<path d="M17 5h10v10L15.5 26.5a1.8 1.8 0 0 1-2.5 0L5.5 19a1.8 1.8 0 0 1 0-2.5Z"/><circle cx="22" cy="10" r="1.7"/>' },
  abroad: { n: '04', label: 'For overseas buyers', icon: '<circle cx="16" cy="16" r="11"/><path d="M5 16h22"/><path d="M16 5c3.1 3 4.7 6.7 4.7 11S19.1 24 16 27c-3.1-3-4.7-6.7-4.7-11S12.9 8 16 5Z"/>' },
};
---
<Base>
  <section class="section center hero" style="padding-top:5rem">
    <div class="wrap">
      <p class="eyebrow both">United Arab Emirates</p>
      <h1 style="max-width:16ch;margin:0 auto">Clarity <em>before commitment.</em></h1>
      <p class="lede" style="margin-inline:auto">UAE property analysis for investors: price, yield, costs and exit, before anyone asks you to sign.</p>
      <div class="actions">
        <a class="btn" href="/contact">Get the numbers on a property</a>
        <a class="btn btn--ghost" href={waLink("Hi Sharjeel, I'd like to speak about UAE real estate.")} target="_blank" rel="noopener">Speak with Sharjeel →</a>
      </div>
    </div>
  </section>

  <div class="band"><div class="wrap trust"><span>UAE Real Estate</span><span>Buyer Representation</span><span>Investment Analysis</span><span>International Clients</span></div></div>

  <section class="section">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow both">What are you looking to do?</p>
        <h2>Four ways people <em>work with me.</em></h2>
      </div>
      <div class="grid grid--pair ways" style="margin-top:2.5rem">
        {intents.map((i, k) => (
          <a class={`card way${k === 1 || k === 2 ? ' way--ink' : ''}`} href={`/contact?intent=${i.value}`}>
            <div class="way-top">
              <span class="way-num" aria-hidden="true">{WAYS[i.value].n}</span>
              <svg class="way-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={WAYS[i.value].icon} />
            </div>
            <p class="way-label">{WAYS[i.value].label}</p>
            <h3>{i.label}</h3>
            <p class="way-text">{BLURBS[i.value]}</p>
            <span class="way-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="narrow center">
      <h2>I don't believe every property<br />is a <em>good investment.</em></h2>
      <p class="lede" style="margin-inline:auto">My job isn't to convince you to buy something. It's to help you decide whether it deserves your money.</p>
      <p>Before I recommend anything, I run five checks: price against real DLD sales, net yield after costs, the developer and the risk, the exit, and my honest view. If I don't think it's right for you, I'll tell you.</p>
      <div class="card" style="max-width:28rem;margin:2rem auto 0;text-align:left">
        <h3 style="color:var(--navy)">The Compass Key Brief</h3>
        <p class="kicker" style="margin-top:.5rem">Price · Returns · Risk · Exit · My View</p>
        <p class="small">Send me any UAE property and I'll run the numbers: price, returns, risk, exit, my view. You can also run your own numbers on the <a href="/invest">ROI Calculator</a>. My method is set out on the <a href="/investment-approach">investment approach</a> page.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">For international clients</p>
        <h2>Buying in the UAE <em>from abroad.</em></h2>
        <p>You don't need to be in the UAE to make a well-informed property decision. Briefing, virtual shortlist, remote viewings, due diligence, negotiation, transaction coordination and handover — all managed on your behalf.</p>
        <div class="actions"><a class="btn btn--ghost" href="/contact?intent=abroad">Start the conversation →</a></div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="narrow center">
      <p class="eyebrow both">UAE market intelligence</p>
      <h2>Numbers, not <em>headlines.</em></h2>
      <p>Property decisions should be based on more than headlines. I track the UAE's transaction activity, pricing, rental market, new launches and area-level trends to help clients understand what the numbers actually mean for their specific decision.</p>
      <p class="small">Read the latest in <a href="/insights">Insights</a>.</p>
    </div>
  </section>

  <section class="section band--navy center">
    <div class="narrow">
      <h2>Ready to <em>talk?</em></h2>
      <p>Tell me what you're looking for. Your budget. Your objective. Your timeline. I'll take it from there.</p>
      <div class="actions"><a class="btn" href="/contact">Get in touch</a></div>
    </div>
  </section>
</Base>
