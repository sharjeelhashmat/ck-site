---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section center">
    <div class="narrow">
      <p class="eyebrow both">404</p>
      <h1>That page <em>isn't here.</em></h1>
      <p class="lede" style="margin-inline:auto">Try the homepage, or tell me what you were looking for.</p>
      <div class="actions"><a class="btn" href="/">Home</a><a class="btn btn--ghost" href="/contact">Contact</a></div>
    </div>
  </section>
</Base>
