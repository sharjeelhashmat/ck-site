---
import Base from '../../layouts/Base.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { loadPublic } from '../../lib/intel-data.mjs';
import { inlineSegments as rich } from '../../lib/intel.mjs';
import { renderTableChart } from '../../lib/chart.mjs';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { LEAD_CAPTURE } from '../../lib/golive';

export function getStaticPaths() {
  const { articles, insightsLive } = loadPublic();
  return articles.map((a: any) => ({ params: { slug: a.slug }, props: { a, insightsLive } }));
}
const { a, insightsLive } = Astro.props;
// Each figure-bearing block lists the sources it comes from; they show as [1] [2] links to the numbered Sources table below.
// A source is named, never linked (owner decision 2026-11-06): s.url stays in the data as the verification record.
const cite = (b: any) => (Array.isArray(b.src) ? b.src : []) as number[];
const propertyAnalysis = ['Would I Buy It?', 'Opportunity vs Risk'].includes(a.series);
---
<Base title={a.title} description={a.metaDescription ?? a.description} noindex={!insightsLive} article={{ headline: a.title, datePublished: a.publishedOn, dateModified: a.updatedOn }}>
  <ReadingProgress />
  <section class="section">
    <div class="narrow brief">
      <p class="eyebrow">{a.series}</p>
      <h1>{a.title}</h1>
      <p class="lede">{a.description}</p>
      <div class="meta">
        <span>By {a.author}</span>
        <span>Published {a.publishedOn}</span>
        <span>Updated {a.updatedOn}</span>
        <span>{a.geography}</span>
        <span>Confidence: {a.confidence}</span>
      </div>
      {a.stale && <p class="stale-banner">This article is past its review date and is being re-checked. Treat the figures as historical until it is updated.</p>}
      {a.body.map((b: any, i: number) => {
        if (b.h) return <h2>{b.h}</h2>;
        if (b.p) return <p>{rich(b.p).map((x) => (x.href ? <a href={x.href}>{x.text}</a> : x.bold ? <strong>{x.text}</strong> : x.text))}{cite(b).map((n) => <sup class="cite"><a href={`#src-${n}`} aria-label={`Source ${n}`}>[{n}]</a></sup>)}</p>;
        if (b.ul) return <><ul>{b.ul.map((s: string) => <li>{rich(s).map((x) => (x.href ? <a href={x.href}>{x.text}</a> : x.bold ? <strong>{x.text}</strong> : x.text))}</li>)}</ul>{cite(b).length > 0 && <p class="src">Sources: {cite(b).map((n) => <a href={`#src-${n}`}>[{n}]</a>)}</p>}</>;
        if (b.table) return (
          <>
            {/* Comparison chart (Rules 1c v6.6) above its table; the table stays the text alternative. */}
            {b.chart && <Fragment set:html={renderTableChart(`chart-${i + 1}`, b.table, b.chart, cite(b))} />}
            <div class="table-scroll" tabindex="0"><table>
              <thead><tr>{b.table.head.map((h: string) => <th>{h}</th>)}</tr></thead>
              <tbody>{b.table.rows.map((r: string[]) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
            </table></div>
            {b.illustration === true && <p class="src">Illustration with made-up numbers, not a real property.</p>}
            {cite(b).length > 0 && <p class="src">Sources: {cite(b).map((n) => <a href={`#src-${n}`}>[{n}]</a>)}</p>}
          </>
        );
        return null;
      })}
      {propertyAnalysis && (
        <div class="grid grid--pair" style="margin-top:var(--space-8)">
          <div><p class="kicker">Why it could work</p><ul>{a.couldWork.map((x: string) => <li>{x}</li>)}</ul></div>
          <div><p class="kicker">Why it could fail</p><ul>{a.couldFail.map((x: string) => <li>{x}</li>)}</ul></div>
        </div>
      )}
      <h2>Sources</h2>
      <div class="table-scroll" tabindex="0"><table>
        <thead><tr><th>#</th><th>Source</th><th>Tier</th><th>Published</th><th>Verified</th></tr></thead>
        <tbody>{a.sources.map((s: any, i: number) => <tr id={`src-${i + 1}`}><td>{i + 1}</td><td>{s.name}</td><td>{s.tier}</td><td>{s.undated ? 'undated page' : s.publishedOn}</td><td>{s.verifiedOn}</td></tr>)}</tbody>
      </table></div>
      <p class="fine" style="margin-top:var(--space-8)">General information, not financial, tax or legal advice. Reviewed by {a.reviewer}; review by {a.reviewBy}.</p>
      {LEAD_CAPTURE && <NewsletterSignup source={`insights/${a.slug}`} variant="article" />}
    </div>
  </section>
</Base>
