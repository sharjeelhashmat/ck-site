---
// Area guide (Part F): the same template for all 16 guides. The copy is owner-approved (2026-10-16) and has no figures;
// the live figures card carries every number. Abu Dhabi figures come from src/data/adrec-areas.json at build time; Dubai
// figures come from the Worker (/market/area/<DLD area>) in the browser. The card stays hidden when there is no data.
import Base from '../../layouts/Base.astro';
import '../../styles/market.css';
import { ADREC, GUIDES, PERIOD, VIEW_HEADING, type Guide } from '../../lib/area-guides';
import { EMIRATES, renderGuideCard } from '../../lib/market.mjs';
import { SITE } from '../../lib/site';
import { loadChanges } from '../../lib/intel-data.mjs';
import { eventsForArea, eventNeedsRecheck } from '../../lib/changes.mjs';

export function getStaticPaths() {
  const { events, projects, today } = loadChanges();
  return GUIDES.map((guide) => ({ params: { slug: guide.slug }, props: { guide, changes: eventsForArea(events, guide.slug), projects, today } }));
}
const { guide, changes, projects, today } = Astro.props as { guide: Guide; changes: any[]; projects: any[]; today: string };
const projectName = (slug: string) => projects.find((p) => p.slug === slug)?.name;
const emirate = EMIRATES[guide.emirate];
const ad = guide.emirate === 'abu_dhabi' ? ADREC.areas.find((a) => a.guide === guide.slug) : undefined;
const adCard = ad
  ? renderGuideCard('abu_dhabi', { period: ADREC.period, published: ADREC.published, source_url: ADREC.source_url, area: { ...ad, label: null } })
  : '';
---
<Base title={guide.h1} description={guide.meta_description ?? guide.one_liner}>
  <section class="section">
    <div class="narrow guide">
      <p class="eyebrow">Area guide · {emirate}</p>
      <h1>{guide.h1}</h1>
      <p class="lede">{guide.one_liner}</p>

      {guide.emirate === 'abu_dhabi' && adCard && <div class="mk-guide-card" set:html={adCard} />}

      <h2 class="guide-h2">What it is</h2>
      <p>{guide.what_it_is}</p>
      {/* Dubai figures arrive from the Worker after load: placed below the first section, not above it, so the text a
          reader starts on does not move when they appear (audit item 26). */}
      {guide.emirate === 'dubai' && (
        <div class="mk-guide-card" id="guide-figures" hidden data-worker={SITE.workerUrl} data-area={guide.dld_area} data-period={PERIOD}></div>
      )}
      <h2 class="guide-h2">Who buys here</h2>
      <p>{guide.who_buys}</p>
      <h2 class="guide-h2">Things to consider</h2>
      <ul class="guide-list">{guide.things_to_consider.map((t) => <li>{t}</li>)}</ul>
      <h2 class="guide-h2">{VIEW_HEADING}</h2>
      <p>{guide.my_view}</p>

      {/* What's changing here (PR 3): official announcements that name this area, newest first. Absent with no events. */}
      {changes.length > 0 && (
        <section class="changes" aria-labelledby="changes-h">
          <h2 class="guide-h2" id="changes-h">What's changing here</h2>
          <ul class="changes-list">
            {changes.map((e) => (
              <li class="change">
                <p class="change-head"><span class="change-title">{e.title}</span> <span class={e.status === 'Cancelled' ? 'badge badge--cancelled' : 'badge'}>{e.status}</span></p>
                {e.officialDate && <p class="src">Official date: {e.officialDate}</p>}
                <p class="change-summary">{e.summary}</p>
                <p class="src">Source: <a href={e.source.url} rel="noopener" target="_blank">{e.source.name}</a> · {eventNeedsRecheck(e, today) ? <span class="fine">last checked <span class="date">{e.source.verifiedOn}</span></span> : <>verified <span class="date">{e.source.verifiedOn}</span></>}</p>
                {e.project && <p class="src"><a href={`/projects/${e.project}`}>Infrastructure tracker: {projectName(e.project)}</a></p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="lede guide-close"><a href="/contact">Ask me</a> about {guide.h1}.</p>
    </div>
  </section>
</Base>

<style>
  .guide .lede { margin-top: 1.25rem; }
  .guide-h2 { margin-top: 3rem; margin-bottom: 0; }
  .guide-list { margin: 1rem 0 0; padding-left: 1.25rem; display: grid; gap: .5rem; }
  .guide .guide-close { margin-top: 3rem; }
  .changes-list { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  .change p { margin: 0; }
  .change .change-summary { margin-top: .4rem; }
  .change-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .6rem; }
  .change-title { font-weight: 600; }
  .change .date { white-space: nowrap; }
</style>

<script>
  import { renderGuideCard } from '../../lib/market.mjs';
  // Dubai guides: live figures from the Worker. Any failure leaves the card hidden (no spinner, no error box).
  const card = document.getElementById('guide-figures');
  if (card) {
    const { worker, area, period } = card.dataset;
    fetch(`${worker}/market/area/${encodeURIComponent(area ?? '')}?period=${encodeURIComponent(period ?? '')}`, { signal: AbortSignal.timeout(8000) })
      .then((r) => (r.ok ? r.json() : null))
      .then((b) => {
        if (!b?.area) return;
        const html = renderGuideCard('dubai', {
          period: b.period,
          dldArea: area,
          area: { rank: b.area.rank, area: b.area.area_en, label: b.area.label, value_bn: b.area.value_bn, share_pct: b.area.share_pct, change_pct: b.area.change_pct, prior_zero: b.area.prior_zero },
        });
        if (!html) return;
        card.innerHTML = html;
        card.hidden = false;
      })
      .catch(() => {});
  }
</script>
