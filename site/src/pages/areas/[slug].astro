---
import Base from '../../layouts/Base.astro';
import { AREAS } from '../../lib/areas';
import { areaSnapshotState, SNAPSHOT_FIELDS } from '../../lib/intel.mjs';
import { today } from '../../lib/intel-data.mjs';
import { waLink } from '../../lib/site';

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props;
const FIELDS = [
  ['buyerProfile', 'Who Buys Here'], ['priceRange', 'Price Range'], ['rentalProfile', 'Rental Profile'],
  ['investmentCase', 'Investment Case'], ['risks', 'Things to Consider'], ['sharjeelView', "Sharjeel's View"],
] as const;
// Decision 5 (2026-09-21): an area page is indexable only when every snapshot figure is sourced, verified and inside its
// 90-day window. Until then it stays noindex and out of the sitemap. A snapshot that goes stale drops back to noindex.
const snap = areaSnapshotState(area, today());
const noindex = !snap.live;
const claims = SNAPSHOT_FIELDS.map((f) => ({ ...f, c: area.details.snapshot?.[f.key as 'priceSqft' | 'rent' | 'netYield'] })).filter((x) => x.c);
---
<Base title={area.name} description={area.overview} noindex={noindex}>
  <section class="section">
    <div class="wrap" style="max-width:56rem">
      <p class="eyebrow">Area Guide</p>
      <h1>{area.name}</h1>
      <p class="lede">{area.overview}</p>
      {claims.length > 0 && (
        <div style="margin-top:2.5rem">
          <p class="kicker">Snapshot</p>
          <div class="grid grid--3">
            {claims.map(({ label, c }) => (
              <div class="card">
                <p class="kicker" style="margin:0">{label}</p>
                <p class="figure">{c!.value}</p>
                <p class="src"><a href={c!.sourceUrl} rel="noopener" target="_blank">{c!.sourceName}</a> · published {c!.publishedOn} · verified {c!.verifiedOn}</p>
              </div>
            ))}
          </div>
        </div>
      )}
      <div class="grid grid--2" style="margin-top:2.5rem">
        {FIELDS.map(([k, label]) => (
          <div class="card"><p class="kicker" style="margin:0">{label}</p><p>{area.details[k] || 'Ask Sharjeel for current data on this.'}</p></div>
        ))}
      </div>
      <div class="actions"><a class="btn" href={waLink(`Hi Sharjeel, I'd like to know more about ${area.name}.`)} target="_blank" rel="noopener">Ask Sharjeel about {area.name}</a></div>
    </div>
  </section>
</Base>
