---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { LEAD_CAPTURE } from '../lib/golive';
// Soft launch (LEAD_CAPTURE false): no valuation form, and the lede's sentence pointing to it is not rendered.
const PROCESS = ['Comparable Analysis', 'Pricing Strategy', 'Marketing', 'Qualified Buyers', 'Negotiation', 'Completion'];
---
<Base title="Sell Your UAE Property" description="Understand your property's market position before deciding what to do next: comparable analysis, pricing strategy and a managed sale process.">
  <section class="section">
    <div class="narrow">
      <p class="eyebrow">Sell</p>
      <h1>Know your position. <em>Before you decide.</em></h1>
      <p class="lede">Understand your property's market position before deciding whether to sell, hold, or re-list.{LEAD_CAPTURE && ' A short valuation request below gets a comparable analysis started.'}</p>
      <ol class="steps">{PROCESS.map((s, i) => <li>{i + 1}. {s}</li>)}</ol>
      {LEAD_CAPTURE && <div style="margin-top:var(--space-12)"><LeadForm mode="sell" submitLabel="Request My Valuation" /></div>}
    </div>
  </section>
</Base>
