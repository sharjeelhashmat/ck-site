{
  // Static-assets-only Worker. Serves ./dist from Cloudflare's edge on the free plan.
  // Deploy target is the owner's Cloudflare account (workers.dev subdomain: sharjeelhashmat).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ck-site-web",
  "compatibility_date": "2026-08-01",
  // Served only on the custom domains www.sharjeelhashmat.com and sharjeelhashmat.com (attached in the dashboard, 5 Nov
  // 2026). No ck-site-web.sharjeelhashmat.workers.dev URL and no *-ck-site-web preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
